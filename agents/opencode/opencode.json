      "~/Development/personal/*": "allow",
      "~/Development/work/*": "allow",
      "~/Repositories/*": "allow",
      "/tmp/*": "allow"
    },
    "question": "allow",
    "codesearch": "allow",
    "skill": {
      "*": "allow",
      "pdf": "deny",
      "xlsx": "deny"
