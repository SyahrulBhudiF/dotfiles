          "*": "deny",
          "*.md": "ask"
        },
        "skill": {
          "*": "deny",
          "code-review-*": "allow",
          "brainstorming": "allow",
          "build-feature": "allow",
          "*-best-practices": "allow"
        }
      }
    }
  },
  "permission": {
    "*": "deny",
    "read": "allow",
    "write": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "list": "allow",
    "grep": "allow",
    "glob": "allow",
    "edit": "allow",
    "external_directory": {
