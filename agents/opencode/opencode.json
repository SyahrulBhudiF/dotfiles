    "inferhub": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "InferHub",
      "options": {
        "baseURL": "https://inferhub.dev/v1",
        "apiKey": "{env:INFERHUB_API_KEY}"
      },
      "models": {
        "auto": {
          "name": "InferHub auto routing",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        }
      }
    },
    "kosyayuk": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kosyayuk",
      "options": {
        "baseURL": "https://ai.naufal.work/v1",
        "apiKey": "{env:AUTH_TOKEN}"
      },
      "models": {
        "gpt-5.6-luna": {
          "name": "Gpt 5 6 Luna",
          "limit": {
            "context": 272000,
            "output": 64000
          },
