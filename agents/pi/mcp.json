{
  "mcpServers": {
    "executor": {
      "url": "http://127.0.0.1:4788/mcp"
    },
    "agent-browser": {
      "command": "agent-browser",
      "args": ["mcp", "--tools", "all"],
      "lifecycle": "keep-alive"
    },
    "fff": {
      "command": "fff-mcp",
      "directTools": false,
      "lifecycle": "keep-alive"
    }
  }
}
