{
  "mcpServers": {
    "cloudflare-api": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "agent-browser": {
      "command": "agent-browser",
      "args": ["mcp", "--tools", "all"],
      "env": {
        "AGENT_BROWSER_IDLE_TIMEOUT_MS": "180000"
      }
    },
    "fff": {
      "command": "fff-mcp"
    }
    // "sentry": {
    //   "type": "http",
    //   "url": "https://mcp.sentry.dev/mcp"
    // }
  }
}
