{
  "mcpServers": {
    "cloudflare-api": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "executor": {
      "url": "http://127.0.0.1:4788/mcp"
    },
    "agent-browser": {
      "command": "agent-browser",
      "args": ["mcp", "--tools", "all"],
      "env": {
        "AGENT_BROWSER_IDLE_TIMEOUT_MS": "180000"
      }
    },
    "fff": {
      "command": "fff-mcp",
      "directTools": false,
      "lifecycle": "keep-alive"
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp",
      "auth": "oauth",
      "lifecycle": "lazy"
    }
  }
}
