{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/home/ryuko/dotfiles/fastfetch/art.txt",
    "padding": {
      "top": 1,
      "left": 0,
      "right": 3
    },
    "printRemaining": true
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue",
      "title": "white",
      "separator": "blue",
      "output": "white"
    }
  },
  "modules": [
    {
      "type": "title",
      "key": "",
      "format": "{user-name}@{host-name}"
    },
    { "type": "separator" },
    { "type": "os", "key": " " },
    { "type": "kernel", "key": " " },
    { "type": "uptime", "key": "󰅐 " },
    { "type": "packages", "key": "󰏖 " },
    { "type": "shell", "key": " " },
    { "type": "wm", "key": " " },
    { "type": "terminal", "key": " " },
    { "type": "cpu", "key": " " },
    { "type": "gpu", "key": "󰍛 " },
    { "type": "memory", "key": " " },
    { "type": "disk", "key": "󰋊 " },
    { "type": "battery", "key": "󰁹 " },
    { "type": "separator" },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 0
    }
  ]
}
